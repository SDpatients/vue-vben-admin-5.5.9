# 端口号
VITE_PORT=5778

VITE_BASE=/
  
# 接口地址（使用空字符串，通过 Vite 代理转发）
VITE_GLOB_API_URL=

# 是否开启 Nitro Mock 服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=true

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局 loading
VITE_INJECT_APP_LOADING=true

# ============================================
# 开发环境代理配置
# ============================================
# 后端API服务地址（用于Vite代理）
VITE_API_PROXY_TARGET=http://192.168.0.151:8080

# 手机上传功能使用的本机 IP 地址（用于生成二维码）
# 如果不设置，会自动检测；如果自动检测失败，会使用默认 IP
# 格式：192.168.x.x
VITE_MOBILE_UPLOAD_IP=192.168.0.151

# ============================================
# 外部链接配置
# ============================================
# 浙江破产管理平台链接
VITE_EXTERNAL_LINK_ZJPCGL=https://pcgl.zjsfgkw.gov.cn:10020/#/login
