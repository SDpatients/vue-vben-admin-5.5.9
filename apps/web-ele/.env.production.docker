VITE_BASE=/

# ============================================
# Docker 部署环境API配置
# ============================================
# 生产环境下前端通过 Nginx 反代访问后端 /api/v1
# 使用相对路径，前后端在同一域名下（同域解决 CORS）
VITE_GLOB_API_URL=/api/v1

# 8080端口API地址（保留与 /api/v1 一致）
VITE_API_URL_8080=/api/v1

# 聊天API地址（与主API一致）
VITE_CHAT_API_URL=/api/v1

# ============================================
# 外部链接配置
# ============================================
VITE_EXTERNAL_LINK_ZJPCGL=https://pcgl.zjsfgkw.gov.cn:10020/#/login

# ============================================
# 构建配置
# ============================================
VITE_COMPRESS=gzip
VITE_PWA=false
VITE_ROUTER_HISTORY=hash
VITE_INJECT_APP_LOADING=true
VITE_ARCHIVER=false