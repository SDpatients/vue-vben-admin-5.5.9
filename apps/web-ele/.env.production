VITE_BASE=/

# ============================================
# 生产环境API配置
# ============================================
# 主API地址（生产环境直接访问后端）
VITE_GLOB_API_URL=

# 8080端口API地址（可选，用于特定服务）
VITE_API_URL_8080=

# 聊天API地址（可选）
VITE_CHAT_API_URL=

# ============================================
# 外部链接配置
# ============================================
# 浙江破产管理平台链接
VITE_EXTERNAL_LINK_ZJPCGL=https://pcgl.zjsfgkw.gov.cn:10020/#/login

# ============================================
# 构建配置
# ============================================
# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
